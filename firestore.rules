rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userBuildingCode() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.buildingCode;
    }

    function isOwner() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isUnassigned() {
      let bc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.buildingCode;
      return bc == null;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && 
        (request.auth.uid == userId || 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']));
      allow delete: if false;
    }

    match /flats/{flatId} {
      allow read: if request.auth != null && (isUnassigned() || resource.data.buildingCode == userBuildingCode());
      allow create: if request.auth != null && request.resource.data.buildingCode == userBuildingCode() && isOwner();
      allow update: if request.auth != null && resource.data.buildingCode == userBuildingCode();
      allow delete: if request.auth != null && resource.data.buildingCode == userBuildingCode() && isOwner();
    }

    match /issues/{issueId} {
      allow read: if request.auth != null && resource.data.buildingCode == userBuildingCode();
      allow create: if request.auth != null
        && request.resource.data.buildingCode == userBuildingCode()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.buildingCode == userBuildingCode()
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          (
            resource.data.createdBy == request.auth.uid
          )
          ||
          (
            isOwner()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );
      allow delete: if request.auth != null
        && resource.data.buildingCode == userBuildingCode()
        && resource.data.createdBy == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if request.auth != null && resource.data.buildingCode == userBuildingCode();
      allow create: if request.auth != null
        && request.resource.data.buildingCode == userBuildingCode()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.buildingCode == userBuildingCode()
        && (
          (
            resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'completed'
            && resource.data.status == 'upcoming'
          )
        );
      allow delete: if request.auth != null
        && resource.data.buildingCode == userBuildingCode()
        && resource.data.createdBy == request.auth.uid;
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.buildingCode == userBuildingCode();
      allow create: if request.auth != null
        && request.resource.data.buildingCode == userBuildingCode()
        && request.resource.data.tenantId == request.auth.uid
        && isOwner() == false;
      allow update: if request.auth != null
        && resource.data.buildingCode == userBuildingCode()
        && (
          (
            isOwner()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ownerNote', 'paidDate'])
          )
          ||
          (
            resource.data.tenantId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transactionRef'])
          )
        );
      allow delete: if false;
    }
  }
}
